# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

FLASK_ENV=development

# JWT auth - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_EXP_WEEKS=4

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=wegoride_user
DB_PASSWORD=
DB_NAME=wego_db
# DB_SSL_CA=/path/to/ca.pem
AUTO_CREATE_TABLES=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_SSL=false

# CORS - comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Payments (Chapa)
PAYMENT_PROVIDER=chapa
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=

# Password-reset email delivery
# MAIL_API_KEY=
# MAIL_FROM_ADDRESS=

# Uploads
MAX_CONTENT_LENGTH_MB=5
